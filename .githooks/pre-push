#!/bin/sh
# Pre-push gate for the fork's identity. Enabled via:
#   git config core.hooksPath .githooks
#
# 1. Never push to anything but the fork: a push whose remote URL names upstream
#    (incoai/splash) is refused for every ref.
# 2. Every upstream-merge commit in the pushed range must pass
#    dev/tools/verify_upstream_merge.sh. A merge counts as an upstream merge when
#    its second parent is in upstream/main; clones without an `upstream` remote
#    skip this part. A merge that is itself in upstream/main is upstream's own
#    history (a rebase onto upstream carries those), not one of our syncs.
# 3. The pushed tip of a fork branch, one whose history contains main, must
#    carry no upstream release repo, tap or install command
#    (dev/tools/check_fork_identity.sh). A branch without main in its history
#    is an upstream PR branch and carries upstream's identity by design.

REMOTE_NAME="$1"
REMOTE_URL="$2"
ZERO=0000000000000000000000000000000000000000

case "$REMOTE_URL" in
    *incoai/splash*|*incoai/homebrew-tap*)
        echo "[pre-push] BLOCKED: $REMOTE_NAME ($REMOTE_URL) is upstream. This fork never pushes there." >&2
        exit 1 ;;
esac

STATUS=0
while read -r LOCAL_REF LOCAL_OID REMOTE_REF REMOTE_OID; do
    [ "$LOCAL_OID" = "$ZERO" ] && continue

    if git rev-parse -q --verify upstream/main >/dev/null 2>&1; then
        if [ "$REMOTE_OID" = "$ZERO" ]; then
            MERGES=$(git rev-list --merges "$LOCAL_OID" --not --remotes=origin 2>/dev/null)
        else
            MERGES=$(git rev-list --merges "$REMOTE_OID..$LOCAL_OID" 2>/dev/null)
        fi
        for MERGE in $MERGES; do
            git merge-base --is-ancestor "$MERGE" upstream/main && continue
            SECOND=$(git rev-parse -q --verify "$MERGE^2") || continue
            git merge-base --is-ancestor "$SECOND" upstream/main || continue
            echo "[pre-push] upstream merge $(git log -1 --format='%h %s' "$MERGE") - running verify_upstream_merge.sh"
            if ! bash dev/tools/verify_upstream_merge.sh "$MERGE"; then
                echo "[pre-push] BLOCKED: $MERGE fails the upstream-merge gate. Fix, amend the merge commit, push again." >&2
                STATUS=1
            fi
        done
    fi

    # A ref without the fork's main in its history is an upstream PR branch
    # (upstream/main plus the commits we send to incoai/splash): it carries
    # upstream's README, tap and install lines by design, so the identity
    # check is for the fork's own branches, every one of which contains main.
    if git rev-parse -q --verify refs/heads/main >/dev/null 2>&1 \
        && ! git merge-base --is-ancestor refs/heads/main "$LOCAL_OID"; then
        echo "[pre-push] $LOCAL_REF: upstream PR branch (fork main not in its history), identity check skipped"
    elif ! bash dev/tools/check_fork_identity.sh "$LOCAL_OID"; then
        echo "[pre-push] BLOCKED: $LOCAL_REF carries upstream identity (see above)." >&2
        STATUS=1
    fi
done

exit "$STATUS"
